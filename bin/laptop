#!/usr/bin/env bash
# laptop: health checks, crash triage, cleanup, updates and the Laptop Doctor dashboard.
# Read-only unless a command says otherwise. Root-level fixes are printed, never run.
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PY="$REPO/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  (cd "$REPO" && uv sync --quiet) || { echo "laptop: run 'uv sync' in $REPO first" >&2; exit 1; }
fi
# Qt's X11 plugin needs libxcb-cursor0; install.sh drops a private copy here when the system lacks it.
[[ -d "$REPO/.venv/extra-lib" ]] && export LD_LIBRARY_PATH="$REPO/.venv/extra-lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
cd "$REPO" && exec "$PY" -m laptop_doctor "$@"
